[client-server]
port = 3306

!includedir /etc/mysql/conf.d/
!includedir /etc/mysql/mariadb.conf.d/

[mysqld]
# Escucha en todas las interfaces (necesario para que WordPress se conecte desde otro contenedor)
bind-address            = 0.0.0.0
port                    = 3306
datadir                 = /var/lib/mysql

# Evita que mariadb intente resolver IPs a nombres de host (más rápido y seguro en Docker)
skip-name-resolve

# MariaDB ejecuta este SQL en el primer arranque para crear BD y usuarios.
# El archivo es generado en runtime por start.sh via envsubst (con las contraseñas reales).
init-file               = /var/lib/mysql/init.sql

# Tamaño del buffer de InnoDB
innodb_buffer_pool_size = 64M
